{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "metro-parking",
	"main": "src/index.ts",
	"compatibility_date": "2025-09-27",
	"observability": {
		"enabled": true
	},
	"compatibility_flags": [
		"nodejs_compat"
	],
	"vars": {},
	"kv_namespaces": [
		{
			"binding": "METRO_KV",
			"id": "62571d563ba1425eb0a27d825e3c935b"
		}
	],
	"triggers": {
		"crons": [
			"*/2 18-23 * * sun-thu",
			"*/2 0 * * mon-fri"
		]
	}
}
